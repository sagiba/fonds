{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fonds/cal-observed.schema.json",
  "title": "Observed CAL financial response shapes",
  "description": "Observed shapes of reviewed CAL recent and history exports, not a provider contract; no source values. Unknown fields are allowed and all-null fields leave future types open. Older posted rows can omit payment history. Billing-month and authentication payloads are not covered.",
  "type": "object",
  "required": [
    "result",
    "statusCode"
  ],
  "properties": {
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/recentResult"
        },
        {
          "$ref": "#/$defs/legacyResult"
        }
      ]
    },
    "statusCode": {
      "type": "integer"
    },
    "statusDescription": {
      "type": "string",
      "x-observed-types": [
        "string"
      ]
    },
    "statusTitle": {
      "x-observed-types": [
        "null"
      ],
      "description": "Only null observed; future type unknown."
    },
    "groupPid": {
      "type": "string",
      "x-observed-types": [
        "string"
      ]
    }
  },
  "additionalProperties": true,
