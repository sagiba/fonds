{
  "name": "fonds",
  "version": "0.1.0",
  "description": "A personal financial evidence ledger: collects card transactions from supported card providers, retains transaction evidence, and serves it over HTTP and MCP.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagiba/fonds.git"
  },
  "homepage": "https://github.com/sagiba/fonds#readme",
  "bugs": {
    "url": "https://github.com/sagiba/fonds/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=100%",
    "check": "npm run format:check && npm run check:links && npm run check:public-text && npm run check:version && npm run check:doc-budget && npm run check:cal-fixtures && npm run lint && npm run typecheck && npm test && npm run build",
    "cli": "tsx src/cli.ts",
    "format": "prettier --write src tests deploy \"scripts/**/*.{ts,mjs}\" \"*.mjs\" neon.ts package.json \"tsconfig*.json\" .prettierrc.json \".github/workflows/*.yml\" \".github/ISSUE_TEMPLATE/*.yml\" .github/dependabot.yml \"**/*.md\"",
    "format:check": "prettier --check src tests deploy \"scripts/**/*.{ts,mjs}\" \"*.mjs\" neon.ts package.json \"tsconfig*.json\" .prettierrc.json \".github/workflows/*.yml\" \".github/ISSUE_TEMPLATE/*.yml\" .github/dependabot.yml \"**/*.md\"",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:public-text": "node scripts/check-public-text.mjs",
    "check:doc-budget": "node scripts/check-doc-budget.mjs",
    "check:cal-fixtures": "tsx tests/providers/cal/scripts/generate-cal-fixtures.ts --check && tsx tests/providers/cal/scripts/check-cal-fixtures.ts",
    "check:version": "node scripts/release-version.mjs --check",
    "serve": "tsx src/server.ts",
    "neon:setup": "tsx deploy/neon/setup.mjs",
    "neon:deploy": "npx --yes neon@8.4.3 deploy --no-env-pull",
    "neon:smoke": "node deploy/neon/smoke.mjs",
    "build:targets": "node scripts/build-targets.mjs",
    "check:targets": "node scripts/check-targets.mjs",
    "pack:npm": "node scripts/npm-package.mjs",
    "check:npm": "node scripts/npm-package.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix && npm run format",
    "benchmark:reconciliation": "tsx scripts/benchmark-reconciliation.ts",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.10",
    "@better-auth/core": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@hono/node-server": "2.1.5",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.10",
    "better-call": "1.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.13",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "lossless-json": "^4.3.2",
    "standardwebhooks": "1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@cloudflare/workers-types": "5.20261016.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@neon/config": "1.9.2",
    "@neon/functions": "0.11.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "pg": "^8.23.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "author": "Sagi Bashari"
}
